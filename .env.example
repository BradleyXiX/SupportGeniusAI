# ==============================================================================
# SupportGeniusAI Environment Variables Template
# Copy this file to .env and configure the secrets appropriately for your environment.
# ==============================================================================

# Server Runtime Configuration
PORT=3000
NODE_ENV=development

# LLM Providers (Configure at least one provider or use local Ollama)
# 1. OpenAI (Recommended for enterprise production: uses gpt-4o-mini & text-embedding-3-small)
OPENAI_API_KEY=

# 2. Google Gemini (Fast multimodal & flash reasoning: uses gemini-1.5-flash)
GEMINI_API_KEY=

# 3. Local Ollama (Local open-weights inference, default: http://localhost:11434)
OLLAMA_URL=http://localhost:11434
OLLAMA_EMBED_MODEL=nomic-embed-text:latest
OLLAMA_CHAT_MODEL=qwen2.5-coder:7b

# Client Webhook Integration (Optional: Dispatches agent tool calls to external CRM/EHR/webhook)
CLIENT_WEBHOOK_URL=

# Security & CORS (Comma-separated list of allowed origins)
# Example: http://localhost:3000,http://127.0.0.1:3000,https://supportgenius.yourdomain.com
CORS_ALLOWED_ORIGINS=http://localhost:3000,http://127.0.0.1:3000

# Rate Limiter Thresholds (AI Gateway Protection)
RATE_LIMIT_WINDOW_MS=60000
RATE_LIMIT_MAX_REQUESTS=10
