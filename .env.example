# ==============================================================================
# SupportGeniusAI Environment Variables Template
# Copy this file to .env and configure the secrets appropriately for your environment.
# Never commit real credentials, session secrets, or API keys to source control.
# ==============================================================================

# Server Runtime Configuration
PORT=3000
NODE_ENV=development

# Operational Mode
# - support: Real knowledge base retrieval and bounded LLM provider inference
# - demo: Deterministic, zero-cost, zero-network customer simulation
APP_MODE=support

# LLM Provider Selection & Retrieval Mode
# LLM_PROVIDER: Selection strategy for chat inference (auto | openai | gemini | ollama). Default: auto
#   - auto: Preserves default precedence (OpenAI -> Gemini -> Ollama) based on available API keys / daemon.
#   - gemini: Explicitly selects Google Gemini for chat inference (requires GEMINI_API_KEY).
#   - openai: Explicitly selects OpenAI for chat inference (requires OPENAI_API_KEY).
#   - ollama: Explicitly selects local Ollama for chat inference.
LLM_PROVIDER=auto

# RETRIEVAL_MODE: Strategy for knowledge document retrieval (vector | keyword). Default: vector
#   - vector: Embeds queries and documents via OpenAI / Ollama embeddings.
#   - keyword: Loads local markdown/text chunks at startup and scores queries via deterministic BM25-like keyword scoring.
#              Requires zero embedding models, contacts zero external embedding APIs, and reads/writes zero cache files.
#   NOTE: Setting LLM_PROVIDER=gemini and RETRIEVAL_MODE=keyword allows running full support mode with GEMINI_API_KEY alone
#         (no OpenAI key and no local Ollama installation/process required).
RETRIEVAL_MODE=vector

# Security & Session Configuration
# SESSION_SECRET: Minimum 32-character random string for signing anonymous session cookies.
# Generate via: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
SESSION_SECRET=replace_with_a_secure_random_string_of_at_least_32_characters

# PUBLIC_ORIGIN: Canonical public origin of this application.
# Must match the scheme and host sent by the browser. In production, HTTPS is required.
# Local development example: http://localhost:3000
# Production example: https://supportgenius.yourdomain.com
PUBLIC_ORIGIN=http://localhost:3000

# LLM Providers (Configure at least one provider or use local Ollama)
# 1. OpenAI (Recommended for enterprise production: uses gpt-4o-mini & text-embedding-3-small)
OPENAI_API_KEY=

# 2. Google Gemini
# GEMINI_API_KEY: Secret API key for Google Gemini API (required when support mode selects Gemini).
# GEMINI_MODEL: Required bare model ID without URL, path, or query characters whenever support mode selects Gemini.
#               Has no working default in server/config/env.js and cannot be omitted (e.g. gemini-3.1-flash-lite).
# NOTE: Legacy models gemini-1.5-flash and gemini-2.0-flash are officially deprecated/shut down by Google.
#       gemini-3.1-flash-lite is the active deployment candidate.
# CAVEAT: Google provides a free-tier rate limit for text generateContent on this model, but free quotas,
#         rate availability, and account project access are never guaranteed. Cost telemetry displays list-price
#         paid-tier estimates ($0.25/1M input tokens, $1.50/1M output tokens, including thinking tokens).
GEMINI_API_KEY=
GEMINI_MODEL=gemini-3.1-flash-lite

# 3. Local Ollama (Local open-weights inference, default: http://localhost:11434)
OLLAMA_URL=http://localhost:11434
OLLAMA_EMBED_MODEL=nomic-embed-text:latest
OLLAMA_CHAT_MODEL=qwen2.5-coder:7b

# Client Webhook Integration (Safe Foundation Note: In this phase, mutating actions fail closed deterministically)
CLIENT_WEBHOOK_URL=

# Security & CORS (Comma-separated list of allowed origins)
# Example: http://localhost:3000,http://127.0.0.1:3000,https://supportgenius.yourdomain.com
CORS_ALLOWED_ORIGINS=http://localhost:3000,http://127.0.0.1:3000

# Rate Limiter Thresholds (AI Gateway Protection)
RATE_LIMIT_WINDOW_MS=60000
RATE_LIMIT_MAX_REQUESTS=10
